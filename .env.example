# Variables de entorno del sitio (spec 03). Copia este archivo a `.env.local`
# y rellena los valores reales. No subas nunca los valores reales al repositorio.

# Clave de la API de Resend (https://resend.com/api-keys). Secreta.
RESEND_API_KEY=

# Buzón interno que recibe los avisos del formulario de contacto.
CONTACT_TO_EMAIL=dtapia@sm8.com.mx

# Remitente de los correos. El dominio tiene que estar verificado en Resend.
CONTACT_FROM_EMAIL="SM8 España <ventas@sm8.es>"

# Orígenes que pueden llamar a POST /api/contact, separados por comas y sin
# barra final. En desarrollo se añade http://localhost:3000 automáticamente.
# Para probar en un preview de Vercel, añade aquí su URL.
ALLOWED_ORIGINS=https://sm8.es,https://www.sm8.es

# Base de las imágenes de los correos (sin barra final). Tiene que ser pública:
# el cliente de correo descarga las imágenes al abrir el mensaje.
EMAIL_ASSETS_URL=https://www.sm8.es
